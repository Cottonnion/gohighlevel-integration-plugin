{
  "name": "yahya-eddaqqaq/syncly",
  "description": "Syncly for GoHighLevel",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Yahya Eddaqqaq",
      "email": "yahyadard@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "woocommerce/action-scheduler": "^4.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "test": "php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist"
  },
  "autoload": {
    "psr-4": {
      "Syncly\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Syncly\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/bootstrap.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
